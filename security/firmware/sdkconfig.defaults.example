# ESP-IDF Secure Boot v2 / flash encryption example baseline.
# Validate board/IDF support and recovery workflow before fusing eFuses.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS=y
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
# Production eFuse changes may permanently restrict debug/recovery.
