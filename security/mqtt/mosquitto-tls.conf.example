# Mosquitto listener example; configure file ownership and test before use.
listener 8883 0.0.0.0
protocol mqtt
cafile /etc/mosquitto/certs/ca-chain.pem
certfile /etc/mosquitto/certs/broker.crt
keyfile /etc/mosquitto/private/broker.key
require_certificate true
use_identity_as_username true
allow_anonymous false
acl_file /etc/mosquitto/acl
# Select TLS 1.3 only if the broker and clients support it.
tls_version tlsv1.3
# Never disable certificate checks on clients.
